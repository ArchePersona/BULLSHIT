{"artifact_count":1,"artifact_paths":["dist/index.html"],"artifacts":[{"artifact_id":"ART-TASK-1c654ed377dd-000","artifact_type":"SOURCE","assignment_id":"TASK-1c654ed377dd","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>IS THIS BULLSHIT? \u2014 Forensic Rhetoric & Fluff Auditor</title>\n  <meta name=\"description\" content=\"A comedic yet razor-sharp rhetorical bullshit detector. Paste any press release, LinkedIn hustle post, or crypto pitch for an instant 0-100% BS audit.\" />\n  \n  <!-- Fonts & Icons -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,700;0,800;1,400&family=Space+Grotesk:wght@400;600;700;800&family=Syne:wght@700;800;900&display=swap\" rel=\"stylesheet\" />\n  <link rel=\"stylesheet\" href=\"styles.css\" />\n</head>\n<body class=\"brutalist-theme\">\n  <!-- Background Grid Glow -->\n  <div class=\"grid-bg\" aria-hidden=\"true\"></div>\n  \n  <!-- Audio Toggle & Top Bar -->\n  <header class=\"top-nav\">\n    <div class=\"brand-badge\">\n      <span class=\"badge-dot\"></span>\n      <span class=\"brand-title\">BS-AUDIT v3.5 // RHETORICAL DEFENSE SYSTEM</span>\n    </div>\n    <div class=\"nav-actions\">\n      <button id=\"soundToggleBtn\" class=\"btn-util\" title=\"Toggle Sound Effects\" aria-label=\"Toggle Sound Effects\">\n        <span id=\"soundIcon\">\ud83d\udd0a</span> SOUND: <span id=\"soundStatus\">ON</span>\n      </button>\n      <button id=\"settingsBtn\" class=\"btn-util\" title=\"Configure Custom API Keys\">\n        \u2699\ufe0f API CONFIG\n      </button>\n      <a href=\"#methodologyModal\" id=\"methodologyBtn\" class=\"btn-util\">\ud83d\udcd6 METHODOLOGY</a>\n    </div>\n  </header>\n\n  <!-- Hero Section -->\n  <main class=\"main-container\">\n    <section class=\"hero-section\">\n      <div class=\"glitch-wrapper\">\n        <h1 class=\"hero-title glitch-text\" data-text=\"IS THIS BULLSHIT?\">\n          IS THIS BULLSHIT?\n        </h1>\n      </div>\n      <p class=\"hero-subtitle\">\n        The unapologetic, AI-powered forensic parser for corporate doublespeak, crypto alchemy, LinkedIn hustle theater, and unsubstantiated claims.\n      </p>\n    </section>\n\n    <!-- Input Area & Control Dock -->\n    <section class=\"workbench-card\">\n      <div class=\"workbench-header\">\n        <div class=\"header-left\">\n          <span class=\"terminal-prompt\">&gt; PASTE_SUSPECT_TEXT</span>\n          <span class=\"char-counter\" id=\"charWordCounter\">0 words | 0 / 25,000 chars</span>\n        </div>\n        <div class=\"preset-pills-container\">\n          <span class=\"preset-label\">Try Sample:</span>\n          <div class=\"preset-pills\" id=\"presetList\">\n            <button class=\"pill-btn\" data-preset=\"layoff\">\ud83c\udfe2 Layoff Memo</button>\n            <button class=\"pill-btn\" data-preset=\"linkedin\">\ud83d\udcbc LinkedIn Guru</button>\n            <button class=\"pill-btn\" data-preset=\"crypto\">\ud83e\ude99 Web3 AI Whitepaper</button>\n            <button class=\"pill-btn\" data-preset=\"startup\">\ud83d\ude80 Pitch Deck Spin</button>\n            <button class=\"pill-btn\" data-preset=\"sane\">\ud83e\uddd8 Genuinely Sane Text</button>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"textarea-wrapper\">\n        <textarea\n          id=\"inputText\"\n          placeholder=\"Paste corporate memos, founder pitches, PR statements, tech announcements, or LinkedIn thought leadership here to begin forensic diagnosis...\"\n          spellcheck=\"false\"\n        ></textarea>\n        <div id=\"textareaWarning\" class=\"textarea-warning hidden\">\u26a0\ufe0f Text exceeds 5,000 words. Excess automatically trimmed for safety.</div>\n      </div>\n\n      <div class=\"workbench-footer\">\n        <div class=\"footer-options\">\n          <label class=\"toggle-label\">\n            <input type=\"checkbox\" id=\"strictModeToggle\" checked />\n            <span class=\"toggle-custom\"></span>\n            <span>Ultra-Skeptic Mode (Maximum Cynicism)</span>\n          </label>\n          <label class=\"toggle-label\">\n            <input type=\"checkbox\" id=\"snarkLevelToggle\" checked />\n            <span class=\"toggle-custom\"></span>\n            <span>Spicy Commentary</span>\n          </label>\n        </div>\n        <div class=\"action-cluster\">\n          <button id=\"clearBtn\" class=\"btn-secondary\">CLEAR</button>\n          <button id=\"analyzeBtn\" class=\"btn-primary\">\n            <span class=\"btn-glow\"></span>\n            <span class=\"btn-text\">\ud83d\udd25 AUDIT TEXT NOW</span>\n          </button>\n        </div>\n      </div>\n    </section>\n\n    <!-- Animated Scanning State (Hidden by default) -->\n    <section id=\"scanningState\" class=\"scanning-state hidden\">\n      <div class=\"scanner-box\">\n        <div class=\"radar-sweep\"></div>\n        <div class=\"scanner-content\">\n          <div class=\"scanner-spinner\"></div>\n          <div class=\"scanner-msg\" id=\"scannerStatusMessage\">Calibrating skepticism sensors...</div>\n          <div class=\"scanner-progress-bar\"><div class=\"scanner-bar-inner\" id=\"scannerProgress\"></div></div>\n          <div class=\"scanner-subtext\" id=\"scannerSubMessage\">Cross-referencing buzzword density and rhetorical fallacies...</div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Results Container (Hidden until analysis is ready) -->\n    <section id=\"resultsContainer\" class=\"results-container hidden\">\n      <!-- Top Verdict Banner & Stamp -->\n      <div class=\"verdict-card\" id=\"verdictCard\">\n        <div class=\"verdict-stamp-container\">\n          <div class=\"verdict-stamp\" id=\"verdictStamp\">CERTIFIED GRADE-A HOGWASH</div>\n        </div>\n        <div class=\"verdict-body\">\n          <div class=\"verdict-badge-row\">\n            <span class=\"status-pill\" id=\"riskTierBadge\">RHETORICAL RISK: SEVERE</span>\n            <span class=\"status-pill\" id=\"readabilityGrade\">READABILITY: JARGON GIBBERISH</span>\n          </div>\n          <h2 class=\"verdict-title\" id=\"verdictHeadline\">\"A Masterclass in Evasive Gaslighting\"</h2>\n          <p class=\"verdict-summary\" id=\"verdictDescription\"></p>\n          <div class=\"verdict-quote-box\" id=\"verdictSnarkQuote\"></div>\n        </div>\n      </div>\n\n      <!-- Score Grid -->\n      <div class=\"score-grid\">\n        <!-- Overall BS Meter -->\n        <div class=\"metric-card highlight-meter\">\n          <div class=\"metric-header\">\n            <span class=\"metric-tag\">OVERALL BS INDEX</span>\n            <span class=\"metric-info-tooltip\" title=\"0% = Absolute clarity and empirical truth; 100% = Pure unfiltered unadulterated fantasy\">\u2139\ufe0f</span>\n          </div>\n          <div class=\"meter-circle-wrap\">\n            <svg class=\"circle-svg\" viewBox=\"0 0 120 120\">\n              <circle class=\"circle-bg\" cx=\"60\" cy=\"60\" r=\"52\"></circle>\n              <circle class=\"circle-progress\" id=\"meterProgressCircle\" cx=\"60\" cy=\"60\" r=\"52\"></circle>\n            </svg>\n            <div class=\"meter-data\">\n              <span class=\"meter-number\" id=\"overallScoreVal\">0%</span>\n              <span class=\"meter-sublabel\" id=\"meterSublabel\">BS LOAD</span>\n            </div>\n          </div>\n          <div class=\"meter-caption\" id=\"meterCaption\">Requires immediate cognitive hazard quarantine.</div>\n        </div>\n\n        <!-- Fact to Fluff Ratio -->\n        <div class=\"metric-card\">\n          <div class=\"metric-header\">\n            <span class=\"metric-tag\">FACT VS. FLUFF RATIO</span>\n          </div>\n          <div class=\"ratio-bar-wrapper\">\n            <div class=\"ratio-bar-container\">\n              <div class=\"ratio-fact-bar\" id=\"ratioFactBar\" style=\"width: 15%;\"></div>\n              <div class=\"ratio-fluff-bar\" id=\"ratioFluffBar\" style=\"width: 85%;\"></div>\n            </div>\n            <div class=\"ratio-labels\">\n              <span class=\"fact-text\">\ud83d\udcca Substantiated: <strong id=\"factPct\">15%</strong></span>\n              <span class=\"fluff-text\">\u2601\ufe0f Pure Fluff: <strong id=\"fluffPct\">85%</strong></span>\n            </div>\n          </div>\n          <div class=\"metric-footer-desc\" id=\"factFluffCommentary\">\n            Only a microscopic fraction contains falsifiable, concrete data.\n          </div>\n        </div>\n\n        <!-- Fallacy Density -->\n        <div class=\"metric-card\">\n          <div class=\"metric-header\">\n            <span class=\"metric-tag\">FALLACY DENSITY</span>\n          </div>\n          <div class=\"metric-large-stat\">\n            <span id=\"fallacyDensityVal\">8.4</span>\n            <span class=\"stat-unit\">per 100 words</span>\n          </div>\n          <div class=\"mini-breakdown\">\n            <span class=\"mini-tag\" id=\"weaselCountBadge\">14 Weasel Words</span>\n            <span class=\"mini-tag\" id=\"buzzwordCountBadge\">9 Jargon Overdoses</span>\n            <span class=\"mini-tag\" id=\"leapCountBadge\">5 Logical Leaps</span>\n          </div>\n          <div class=\"metric-footer-desc\" id=\"fallacyCommentary\">\n            Contains an astonishing number of rhetorical escape hatches.\n          </div>\n        </div>\n\n        <!-- Rhetorical Posture -->\n        <div class=\"metric-card\">\n          <div class=\"metric-header\">\n            <span class=\"metric-tag\">RHETORICAL SPECIES</span>\n          </div>\n          <div class=\"species-display\">\n            <div class=\"species-icon\" id=\"speciesEmoji\">\ud83c\udfaa</div>\n            <div class=\"species-info\">\n              <h4 id=\"speciesTitle\">Corporate Empathy Illusion</h4>\n              <p id=\"speciesDesc\">Hides harsh business metrics beneath pseudo-caring communal jargon.</p>\n            </div>\n          </div>\n          <div class=\"species-antidote\">\n            <strong>\ud83d\udca1 Antidote:</strong> <span id=\"speciesAntidote\">Demand simple numeric deliverables without adjectives.</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Interactive Teardown & Highlighting Section -->\n      <div class=\"teardown-section\">\n        <div class=\"teardown-header\">\n          <div class=\"teardown-title-group\">\n            <h3>\ud83d\udd2c FORENSIC CLAIM TEARDOWN</h3>\n            <p>Click any highlighted claim below to inspect why it failed rhetorical inspection.</p>\n          </div>\n          <div class=\"filter-badge-group\" id=\"teardownFilters\">\n            <button class=\"filter-pill active\" data-filter=\"all\">All Flagged (<span id=\"totalFlagCount\">0</span>)</button>\n            <button class=\"filter-pill\" data-filter=\"fiction\">\ud83d\udea8 Fiction</button>\n            <button class=\"filter-pill\" data-filter=\"weasel\">\ud83e\udda1 Weasel Words</button>\n            <button class=\"filter-pill\" data-filter=\"source\">\ud83e\uddd0 Trust Me Bro</button>\n            <button class=\"filter-pill\" data-filter=\"buzzword\">\u26a1 Buzzword</button>\n            <button class=\"filter-pill\" data-filter=\"leap\">\ud83e\udd98 Logical Leap</button>\n            <button class=\"filter-pill\" data-filter=\"gaslight\">\ud83d\udd6f\ufe0f Gaslighting</button>\n          </div>\n        </div>\n\n        <!-- Text Viewer with interactive inline highlights -->\n        <div class=\"interactive-viewer-container\">\n          <div class=\"viewer-toolbar\">\n            <span class=\"viewer-label\">LIVE FORENSIC VIEWER</span>\n            <button id=\"copyAnnotatedTextBtn\" class=\"btn-sm-action\">\ud83d\udccb Copy Plain Text</button>\n          </div>\n          <div class=\"annotated-text-box\" id=\"annotatedTextBox\">\n            <!-- Dynamically populated annotated text -->\n          </div>\n        </div>\n\n        <!-- Granular Claims List -->\n        <div class=\"claims-list-wrapper\">\n          <h4 class=\"claims-list-title\">Detailed Violation Breakdown</h4>\n          <div class=\"claims-grid\" id=\"claimsListContainer\">\n            <!-- Dynamic Cards -->\n          </div>\n        </div>\n      </div>\n\n      <!-- Sharing & Export Bar -->\n      <div class=\"export-bar-card\">\n        <div class=\"export-info\">\n          <h4>\ud83d\udce2 SPREAD THE TRUTH</h4>\n          <p>Generate a high-res scorecard image or grab a direct permalink hash to shame this rhetoric publicly.</p>\n        </div>\n        <div class=\"export-actions\">\n          <button id=\"downloadCardBtn\" class=\"btn-action-hero\">\n            \ud83d\uddbc\ufe0f DOWNLOAD SCORECARD (PNG)\n          </button>\n          <button id=\"copyShareUrlBtn\" class=\"btn-secondary\">\n            \ud83d\udd17 COPY SHARE LINK\n          </button>\n          <button id=\"tweetBtn\" class=\"btn-secondary\">\n            \ud83d\udc26 SHARE TO X / TWITTER\n          </button>\n        </div>\n      </div>\n    </section>\n\n    <!-- Disclaimer & Satire Notice -->\n    <footer class=\"page-footer\">\n      <div class=\"footer-divider\"></div>\n      <p class=\"disclaimer-text\">\n        <strong>DISCLAIMER:</strong> This tool performs rhetorical, linguistic, and comedic heuristic deconstructions. While it relies on strict logical fallacy recognition and claim decomposition frameworks, scores and snarky verdicts are intended for entertainment, educational critical-thinking drills, and rhetorical defense.\n      </p>\n      <div class=\"footer-meta\">\n        <span>IS THIS BULLSHIT? &copy; <span id=\"currentYear\">2025</span></span>\n        <span>NO DATA STORED ON SERVER &bull; 100% CLIENT / SECURE PROXY</span>\n      </div>\n    </footer>\n  </main>\n\n  <!-- Popover / Inspector Modal -->\n  <div id=\"claimPopoverModal\" class=\"modal-backdrop hidden\" role=\"dialog\" aria-modal=\"true\">\n    <div class=\"modal-window popover-card\">\n      <div class=\"modal-header\">\n        <div class=\"popover-badge-tag\" id=\"popoverTag\">\ud83d\udea8 UNFOUNDED CLAIM</div>\n        <button id=\"closePopoverBtn\" class=\"modal-close-btn\">&times;</button>\n      </div>\n      <div class=\"modal-body\">\n        <div class=\"popover-quote-block\">\n          <span class=\"quote-icon\">\u201c</span>\n          <p id=\"popoverQuoteText\"></p>\n        </div>\n        <div class=\"popover-detail-row\">\n          <strong>Diagnosis:</strong>\n          <span id=\"popoverDiagnosis\"></span>\n        </div>\n        <div class=\"popover-detail-row\">\n          <strong>Why it's BS:</strong>\n          <p id=\"popoverReasoning\"></p>\n        </div>\n        <div class=\"popover-translation-box\">\n          <span class=\"trans-label\">\ud83d\udde3\ufe0f Plain English Translation:</span>\n          <p id=\"popoverTranslation\"></p>\n        </div>\n        <div class=\"popover-severity-bar\">\n          <span>Cringe Level:</span>\n          <div class=\"cringe-meter\"><div id=\"popoverCringeBar\" class=\"cringe-fill\"></div></div>\n          <span id=\"popoverCringePct\">95%</span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Settings Modal (Custom API Keys) -->\n  <div id=\"settingsModal\" class=\"modal-backdrop hidden\" role=\"dialog\" aria-modal=\"true\">\n    <div class=\"modal-window settings-card\">\n      <div class=\"modal-header\">\n        <h3>\u2699\ufe0f ENGINE & API CONFIGURATION</h3>\n        <button id=\"closeSettingsBtn\" class=\"modal-close-btn\">&times;</button>\n      </div>\n      <div class=\"modal-body\">\n        <p class=\"settings-intro\">\n          By default, <strong>IS THIS BULLSHIT?</strong> runs an internal high-speed Neural Heuristic Fallacy Parser in your browser (no keys needed). If you want real LLM deep reasoning, paste your own key below (stored safely only in your local browser storage):\n        </p>\n        <div class=\"form-group\">\n          <label for=\"engineSelect\">Active Engine:</label>\n          <select id=\"engineSelect\" class=\"form-input\">\n            <option value=\"heuristic\" selected>Built-in Forensic Heuristic AI (Free, Zero Latency)</option>\n            <option value=\"openai\">OpenAI (GPT-4o / GPT-4o-mini)</option>\n            <option value=\"anthropic\">Anthropic Claude (Claude 3.5 Sonnet)</option>\n            <option value=\"openrouter\">OpenRouter (Any Model)</option>\n          </select>\n        </div>\n        <div class=\"form-group hidden\" id=\"apiKeyGroup\">\n          <label for=\"customApiKey\">API Key:</label>\n          <input type=\"password\" id=\"customApiKey\" class=\"form-input\" placeholder=\"sk-...\" />\n          <small>Keys are never sent to our backend. Direct fetch from browser.</small>\n        </div>\n        <div class=\"form-group hidden\" id=\"modelSelectGroup\">\n          <label for=\"customModelName\">Model Identifier (Optional):</label>\n          <input type=\"text\" id=\"customModelName\" class=\"form-input\" placeholder=\"e.g. gpt-4o-mini or claude-3-5-sonnet-20241022\" />\n        </div>\n        <div class=\"settings-buttons\">\n          <button id=\"saveSettingsBtn\" class=\"btn-primary\">SAVE PREFERENCES</button>\n          <button id=\"resetSettingsBtn\" class=\"btn-secondary\">RESET TO DEFAULT</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Methodology Modal -->\n  <div id=\"methodologyModalBackdrop\" class=\"modal-backdrop hidden\" role=\"dialog\" aria-modal=\"true\">\n    <div class=\"modal-window methodology-card\">\n      <div class=\"modal-header\">\n        <h3>\ud83d\udcd6 RHETORICAL AUDIT TAXONOMY</h3>\n        <button id=\"closeMethodologyBtn\" class=\"modal-close-btn\">&times;</button>\n      </div>\n      <div class=\"modal-body scrollable-modal\">\n        <p>Our auditing engine decomposes text against six core categories of deceptive prose:</p>\n        <ul class=\"methodology-list\">\n          <li><span class=\"badge-sample badge-fiction\">\ud83d\udea8 Pure Fiction</span>: Claims presented as indisputable reality without verifiable empirical evidence or concrete data.</li>\n          <li><span class=\"badge-sample badge-weasel\">\ud83e\udda1 Weasel Words</span>: Evasive qualifiers like <em>\"experts agree\"</em>, <em>\"some say\"</em>, <em>\"growing consensus\"</em>, or passive voice created to avoid accountability.</li>\n          <li><span class=\"badge-sample badge-source\">\ud83e\uddd0 Source: Trust Me Bro</span>: Bold statistical assertions or historic breakthroughs with zero citations or methodology.</li>\n          <li><span class=\"badge-sample badge-buzzword\">\u26a1 Buzzword Overdose</span>: High-syllable jargon density intended to intimidate readers into submission without conveying substance.</li>\n          <li><span class=\"badge-sample badge-leap\">\ud83e\udd98 Logical Leap</span>: Non-sequiturs and causality confusion (e.g. <em>\"we drink coffee, therefore revenue will 10x\"</em>).</li>\n          <li><span class=\"badge-sample badge-gaslight\">\ud83d\udd6f\ufe0f Corporate Gaslighting</span>: Wrapping painful realities (layoffs, price gouging, broken promises) in faux-empathy or triumph.</li>\n        </ul>\n      </div>\n    </div>\n  </div>\n\n  <!-- Offscreen Canvas for Card Export -->\n  <canvas id=\"exportCanvas\" width=\"1200\" height=\"675\" style=\"display:none;\"></canvas>\n\n  <!-- Toast Notification Container -->\n  <div id=\"toastContainer\" class=\"toast-container\"></div>\n\n  <script src=\"app.js\"></script>\n</body>\n</html>","description":"","filepath":"dist/index.html","metadata":{"assignment_id":"TASK-1c654ed377dd","capability_id":"","language":"html","provider_execution_id":"vx-1789421351-1","provider_id":"PROVIDER-VERTEX-0004","provider_type":